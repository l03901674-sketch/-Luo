@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap');
:root{color-scheme:dark;--bg:#101827;--panel:#172235;--line:#2b3a50;--text:#f5f7fb;--muted:#a7b2c4;--accent:#a7e0cf;--accent2:#d2f3e8}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -20%,#263d53 0,transparent 55%),var(--bg);color:var(--text);font-family:Cairo,system-ui,sans-serif;min-height:100vh}.shell{width:min(760px,calc(100% - 32px));margin:auto;padding:24px 0 18px;min-height:100vh;display:flex;flex-direction:column}.topbar{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:10px;color:white;text-decoration:none;font-weight:800;letter-spacing:3px}.logo{display:grid;place-items:center;width:38px;height:38px;border-radius:13px;background:var(--accent);color:#12212a;font-size:23px}.hero{padding:54px 0 28px}.eyebrow{color:var(--accent);font-size:13px;font-weight:700}.hero h1{font-size:clamp(34px,7vw,54px);line-height:1.25;margin:10px 0}.hero h1 span{color:var(--accent)}.hero p,.muted{color:var(--muted);line-height:1.9}.hero p{max-width:540px;margin:0}.panel{background:rgba(23,34,53,.94);border:1px solid var(--line);border-radius:22px;padding:26px;box-shadow:0 20px 60px #0002}.narrow{max-width:460px;width:100%;align-self:center}.panel h2{margin:0;font-size:22px}.panel-head,.result-head{display:flex;justify-content:space-between;align-items:center;gap:16px}.panel-head p{margin:3px 0 20px}label{display:block;font-weight:700;margin:16px 0 8px}input[type=password]{width:100%;background:#101a2a;border:1px solid var(--line);border-radius:12px;padding:14px;color:white;font:inherit;outline:none}input:focus{border-color:var(--accent)}button{font:inherit;cursor:pointer;border:0}.primary{display:block;width:100%;padding:13px 18px;border-radius:12px;background:var(--accent);color:#13232a;font-weight:800;margin-top:18px}.primary:disabled{opacity:.6;cursor:wait}.ghost,.install{border:1px solid var(--line);background:transparent;color:var(--text);border-radius:10px;padding:8px 13px}.install{border-color:#547d73;color:var(--accent)}.dropzone{border:1px dashed #587064;border-radius:16px;padding:28px 15px;text-align:center;background:#101a2a;display:flex;flex-direction:column;align-items:center;gap:7px;cursor:pointer}.upload-icon{font-size:30px;color:var(--accent)}.dropzone .muted{font-size:13px}.status{margin-top:14px;color:var(--accent);min-height:24px}.status.error{color:#ffaaa8}.result{border-top:1px solid var(--line);margin-top:14px;padding-top:18px}.result h3{margin:0}.result pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;line-height:2;color:#e8edf5;background:#101a2a;border-radius:14px;padding:18px;max-height:65vh;overflow:auto}.note{color:var(--muted);font-size:12px}.hidden{display:none!important}footer{margin-top:auto;padding:34px 0 4px;text-align:center;color:#8190a5;font-size:12px}@media(max-width:520px){.shell{width:calc(100% - 24px);padding-top:16px}.hero{padding:42px 0 22px}.panel{padding:19px;border-radius:18px}.panel-head{align-items:flex-start}.panel-head .ghost{font-size:12px;white-space:nowrap}}

